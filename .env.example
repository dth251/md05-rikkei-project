POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
AUTH_DB_PASSWORD=REPLACE_WITH_RANDOM_AUTH_PASSWORD
PRODUCT_DB_PASSWORD=REPLACE_WITH_RANDOM_PRODUCT_PASSWORD
ORDER_DB_PASSWORD=REPLACE_WITH_RANDOM_ORDER_PASSWORD
PAYMENT_DB_PASSWORD=REPLACE_WITH_RANDOM_PAYMENT_PASSWORD
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_RANDOM_NOTIFICATION_PASSWORD
RABBITMQ_DEFAULT_USER=commerce_app
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RANDOM_RABBITMQ_PASSWORD
# New volumes use the stable hostname rabbitmq. Existing volumes must preserve the active node hostname.
# RABBITMQ_HOSTNAME=EXISTING_CONTAINER_HOSTNAME_FROM_DOCKER_INSPECT
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
PRODUCT_RPC_TOKEN=REPLACE_WITH_64_LOWERCASE_HEX_RANDOM_CHARACTERS
DOMAIN=md05-rikkei-project.duckdns.org
AUTH_IMAGE=ghcr.io/dth251/md05-rikkei-project/auth-service
IMAGE_TAG=REPLACE_WITH_TESTED_COMMIT_SHA
# Enable only after private sandbox merchant credentials have been provisioned.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Numeric public address of the merchant server, required before refund/querydr.
VNPAY_SERVER_IP=
VNPAY_RETURN_URL=https://md05-rikkei-project.duckdns.org/api/payments/vnpay/return

# SMTP remains disabled until private credentials and a dedicated recipient API token are configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_RECIPIENT_TOKEN=
GRAFANA_ADMIN_PASSWORD=
MONITOR_DB_PASSWORD=
MONITORING_ENABLED=false
SMTP_SANDBOX_ENABLED=false
RESERVATION_TTL=PT150S
